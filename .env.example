# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth (Web Client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id

# Supabase Server-Side (Vercel env vars)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# VAPID Push Notifications (Vercel env vars)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Resend Email (Vercel env vars)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=DirectRefer <noreply@directrefer.in>

# Resume Token Signing (Vercel env var, recommended to set separately)
RESUME_SIGNING_SECRET=your_random_signing_secret

# PWA / Push (client-side)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# WhatsApp Business Cloud API (Vercel env vars)
# Get these from Meta for Developers > WhatsApp > Getting Started
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
VITE_WHATSAPP_BUSINESS_NUMBER=1XXXXXXXXXX
