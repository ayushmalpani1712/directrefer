{
  "manifest_version": 3,
  "name": "DirectRefer — Job Referrals",
  "version": "1.0.0",
  "description": "Find verified employee referrers at top Indian tech companies. Get referred, get hired.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://ecdqnysmosxmojhvxbdu.supabase.co/*",
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.naukri.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
